#include "resource.h"

// Embedded as raw RCDATA (not a Windows FONT resource, which triggers a system-wide
// AddFontResource-style install) -- loaded at runtime via AddFontMemResourceEx
// (overlay_hud.cpp) as a private, in-process-only font, never touching the user's
// system font list. Isotherm Sans (2026-08-24, replacing the previously-bundled
// Barlow Condensed SemiBold), paired with its Italic style -- same regular+italic
// pairing this project has always bundled, just a different family.
//
// BOTH the "Condensed" and "UI" styles are bundled, 2026-08-24 -- see resource.h's
// own comment for the full history (measured widths, the name-table rename needed
// to make them independently selectable, and why "UI" alone wasn't the right
// blanket default: "condensed only works for the throwback prompt and turrets etc,
// the normal ui text looks better for stuff like buy stations, pickups and
// interacts"). "Isotherm Sans UI" is the general default; "Isotherm Sans"
// (Condensed) is requested explicitly only by the hint call sites that want it.
// IsothermSans-UI.ttf/-UI-Italic.ttf are this project's own renamed copies of the
// upstream repo's UI/Italic files (name table only, glyphs untouched) -- the
// unrenamed originals would collide with Condensed under the same family name. See
// resource.h for the licensing note and README.md for attribution.
IDR_FONT_ISOTHERMSANS           RCDATA "..\\assets\\fonts\\IsothermSans-Condensed.ttf"
IDR_FONT_ISOTHERMSANS_ITALIC    RCDATA "..\\assets\\fonts\\IsothermSans-Italic.ttf"
IDR_FONT_ISOTHERMSANS_UI        RCDATA "..\\assets\\fonts\\IsothermSans-UI.ttf"
IDR_FONT_ISOTHERMSANS_UI_ITALIC RCDATA "..\\assets\\fonts\\IsothermSans-UI-Italic.ttf"

// Controller-glyph icons (issue #48, 2026-07-31) -- the real, already-extracted PNGs
// from assets/button_glyphs/, embedded directly rather than loaded from loose files
// on disk, same reasoning as the fonts above: no separate deployment step, no
// silently-missing-file failure mode. Named as BAREWORD string resource names (NOT
// quoted string literals -- rc.exe accepts quoted names but FindResourceA then can't
// look them up by the same plain ANSI string, confirmed live 2026-07-31: every lookup
// returned a null handle until the quotes were removed) so overlay_hud.cpp's icon
// loader can look one up directly by the same asset-name string
// analog_input_hooks.cpp's existing GlyphAssetName() table already returns, with no
// ID-mapping table to keep in sync on either side.
dpad_down RCDATA "..\\assets\\button_glyphs\\dpad_down.png"
dpad_left RCDATA "..\\assets\\button_glyphs\\dpad_left.png"
dpad_right RCDATA "..\\assets\\button_glyphs\\dpad_right.png"
dpad_up RCDATA "..\\assets\\button_glyphs\\dpad_up.png"
