#include "resource.h"

// Embedded as raw RCDATA (not a Windows FONT resource, which triggers a system-wide
// AddFontResource-style install) -- loaded at runtime via AddFontMemResourceEx
// (overlay_hud.cpp) as a private, in-process-only font, never touching the user's
// system font list. Files are the actual, unmodified Google Fonts static instances;
// see resource.h for the licensing note and README.md for attribution.
IDR_FONT_BARLOWCONDENSED_SEMIBOLD        RCDATA "..\\assets\\fonts\\BarlowCondensed-SemiBold.ttf"
IDR_FONT_BARLOWCONDENSED_SEMIBOLD_ITALIC RCDATA "..\\assets\\fonts\\BarlowCondensed-SemiBoldItalic.ttf"

// Controller-glyph icons (issue #48, 2026-07-31) -- the real, already-extracted PNGs
// from assets/button_glyphs/, embedded directly rather than loaded from loose files
// on disk, same reasoning as the fonts above: no separate deployment step, no
// silently-missing-file failure mode. Named as BAREWORD string resource names (NOT
// quoted string literals -- rc.exe accepts quoted names but FindResourceA then can't
// look them up by the same plain ANSI string, confirmed live 2026-07-31: every lookup
// returned a null handle until the quotes were removed) so overlay_hud.cpp's icon
// loader can look one up directly by the same asset-name string
// analog_input_hooks.cpp's existing GlyphAssetName() table already returns, with no
// ID-mapping table to keep in sync on either side.
dpad_down RCDATA "..\\assets\\button_glyphs\\dpad_down.png"
dpad_left RCDATA "..\\assets\\button_glyphs\\dpad_left.png"
dpad_right RCDATA "..\\assets\\button_glyphs\\dpad_right.png"
dpad_up RCDATA "..\\assets\\button_glyphs\\dpad_up.png"
ps_circle RCDATA "..\\assets\\button_glyphs\\ps_circle.png"
